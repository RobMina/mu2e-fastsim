# T-VR1 reference (KPP run 124155 dig, unpacked with unpack_data_vst_fullmap_head.fcl): reco_data_vst.fcl hit reco -> dumper.
# Needs crv_efficiency/fcl on FHICL_FILE_PATH (offspill window 0-256000 ns, makePH.Unsorted, PBTFSD, uncalibrated tracker).
#include "reco_data_vst.fcl"
services.TFileService.fileName : "strawhits_ref_data.root"
physics.analyzers.trkdump : { module_type : StrawHitTableDumper }
physics.RecoPath : [ PBTFSD, makeSH, makePH ]
physics.trigger_paths : [ RecoPath ]
physics.DumpPath : [ trkdump ]
physics.end_paths : [ DumpPath ]
outputs : {}
