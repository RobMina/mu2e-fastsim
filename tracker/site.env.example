# Site settings for the tracker scripts. Copy to site.env (keep it outside version control), fill in, and
# `source site.env` before running. Every script stops with a message naming a variable it needs that is unset;
# nothing falls back to a user name or a built-in site path. Values below are placeholders.
# The umbrella repository (mu2e-fastsim) site.env.example is the main list and uses the same names; this file adds the
# variables only tracker scripts read.

# Shared (umbrella) settings
export M2FS_CODE=/path/to/mu2e-fastsim               # umbrella checkout (core/, crv/, tracker/); scripts use $M2FS_CODE/core
export M2FS_DATA=/path/to/your/data/area             # writable data area; also the root of saved campaign inputs
export M2FS_INPUTS=/path/to/approved/inputs          # read-only input release (default for kit tracker inputs)
# export M2FS_CORE=/path/to/pinned/core              # optional: a pinned core tree instead of $M2FS_CODE/core
export PY_JAX=/path/to/jax/venv/bin/python3          # a Python with JAX, NumPy and uproot (F1/F2 and autonomous scripts)
# export VENV=/path/to/jax/venv                      # eaf_steps_gpu.sh: virtual environment (created there if missing)
export CRVEXTRAP=/path/to/mu2e_track_crv_mcresponse  # crvextrap import directory (ntuple/straw_occ/secondary scripts)

# CRV-stage names used by tracker scripts
export CRVFS_DATA=$M2FS_INPUTS/crv_fastsim           # CRV input tables and geometry (GDML default: $CRVFS_DATA/geometry/...)
export CRVFS_PNFS=/path/to/dcache/scratch/crv_fastsim  # CRV grid outputs (g4ref_v2 gen/dts)
export CRVFS_OWNER=your-grid-user-name               # owner field of the CRV-stage (g4ref) Mu2e file names

# Tracker stage
export TRKFS_CODE=$M2FS_CODE/tracker                 # this repository; art/run_digi_ref.sh uses $TRKFS_CODE/art (or TRKFS_ART)
export TRKFS_PNFS=/path/to/dcache/scratch/trk_fastsim  # tracker grid outputs (dCache scratch)
export TRKFS_OWNER="$CRVFS_OWNER"                    # owner field of the tracker-stage Mu2e file names (grid outputs)
export TRKFS_MUSE_AREAS=/path/to/muse/work/areas     # directory holding the muse work areas of the saved F1 captures
# export TRK_FASTRECO_DATA=$M2FS_DATA/trk_fastreco   # optional: F1 inputs (default shown)
# export F1_PUBLISHER_ART=/path/to/tracker/art       # F1 native-capture pair drivers: art/ of the frozen tracker checkout

# Hosts, Slurm cluster work area and account
export FASTSIMKIT_FNAL_HOST=your-fnal-interactive-host   # FNAL host the kit streams tracker inputs from
export FASTSIMKIT_SLURM_HOST=your-slurm-login-host       # ssh name of the cluster login (uva_steps_stream.sh)
export FASTSIMKIT_SLURM_ACCOUNT=your-slurm-account       # Slurm account (uva_steps_stream.sh passes it with -A)
export SBATCH_ACCOUNT="$FASTSIMKIT_SLURM_ACCOUNT"        # read by sbatch itself for scripts submitted directly
export FASTSIMKIT_SCRATCH=/path/to/cluster/work/area # holds inputs/, mu2efastsim.sif, kpp/ logs, environments/
export M2FS_UVA="$FASTSIMKIT_SCRATCH"                # area used by uva_steps_gpu.sh (default FASTSIMKIT_SCRATCH)
# export UVA_HOST=your-slurm-login-host              # optional override of FASTSIMKIT_SLURM_HOST in uva_steps_stream.sh
# export CVMFSEXEC_DIST=/path/to/prepared/cvmfsexec  # ordered_stock_*_uva.sh: cvmfsexec distribution for offline_uva.sh

# Kit tracker_point endpoint (trkfastsim.kit_uva)
# export FASTSIMKIT_TRACKER_DATA=$M2FS_INPUTS        # FNAL-side root of the tracker inputs (default: M2FS_INPUTS, then M2FS_DATA)
# export FASTSIMKIT_TRACKER_CODE=$FASTSIMKIT_SCRATCH/tracker_code_kit   # code snapshot on the cluster (default shown)
