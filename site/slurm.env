# Site preset for kit tasks on your own Slurm cluster (hep-endpoints slurm_ssh), sourced on the kit host: any machine
# with ssh to the cluster's login host and to a Mu2e GPVM, the FNAL host that streams the inputs into the jobs.
#   export M2FS_INPUTS=<release root> MANIFEST=<manifest>      # from your access request, as seen on the FNAL host
#   export M2FS_DATA=<writable output area on the kit host>
#   export FASTSIMKIT_FNAL_HOST=<ssh name of a Mu2e GPVM> FASTSIMKIT_SLURM_HOST=<ssh name of the login host>
#   export FASTSIMKIT_SLURM_ACCOUNT=<your Slurm account> FASTSIMKIT_SCRATCH=<your work area on the cluster>
#   source site/slurm.env && python3 site/check.py slurm
# The image is built once with container/build.sh and copied to $FASTSIMKIT_SIF on the cluster (QUICKSTART.md).

. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/common.sh" || return 1 2>/dev/null || exit 1

: "${FASTSIMKIT_FNAL_HOST:?set FASTSIMKIT_FNAL_HOST to the ssh name of a Mu2e GPVM}"
: "${FASTSIMKIT_SLURM_HOST:?set FASTSIMKIT_SLURM_HOST to the ssh name of your cluster login host}"
: "${FASTSIMKIT_SLURM_ACCOUNT:?set FASTSIMKIT_SLURM_ACCOUNT to your Slurm account}"
: "${FASTSIMKIT_SCRATCH:?set FASTSIMKIT_SCRATCH to your work area on the cluster (as seen there)}"
export FASTSIMKIT_FNAL_HOST FASTSIMKIT_SLURM_HOST FASTSIMKIT_SLURM_ACCOUNT FASTSIMKIT_SCRATCH
export FASTSIMKIT_ENDPOINT=uva                       # the slurm_ssh adapter; the name is historical
export SBATCH_ACCOUNT="$FASTSIMKIT_SLURM_ACCOUNT"
export FASTSIMKIT_SIF="${FASTSIMKIT_SIF:-$FASTSIMKIT_SCRATCH/mu2efastsim.sif}"
export FASTSIMKIT_WORKDIR="${FASTSIMKIT_WORKDIR:-$FASTSIMKIT_SCRATCH/kit}"
export M2FS_UVA="$FASTSIMKIT_SCRATCH"
