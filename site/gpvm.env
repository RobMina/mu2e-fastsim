# Site preset for a Mu2e GPVM (Fermilab interactive host). From the umbrella checkout:
#   export M2FS_INPUTS=<release root> MANIFEST=<manifest>      # from your access request (setup/README.md)
#   export M2FS_DATA=<your Mu2e data area>/fastsim             # writable, with quota; not the app area or $HOME
#   source site/gpvm.env && python3 site/check.py gpvm
# The Python environment is a venv at $M2FS_VENV (QUICKSTART.md): `pyenv ana` has no JAX, which the beam stage needs.
# Optional: drive kit tasks on EAF from here by setting EAF_TOKEN_FILE to your own mode-600 hub token file.

. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/common.sh" || return 1 2>/dev/null || exit 1

export FASTSIMKIT_ENDPOINT="${FASTSIMKIT_ENDPOINT:-eaf}"
export FASTSIMKIT_EAF_SHARED_PREFIX="${FASTSIMKIT_EAF_SHARED_PREFIX:-$M2FS_DATA}"
export FASTSIMKIT_EAF_CODE="$M2FS_CODE" FASTSIMKIT_EAF_VENV="$M2FS_VENV"
export FASTSIMKIT_EAF_WORKDIR="$M2FS_DATA/eafkit"
export JAX_PLATFORMS="${JAX_PLATFORMS:-cpu}"          # GPVMs have no GPU
if [ -x "$M2FS_VENV/bin/python3" ]; then export PATH="$M2FS_VENV/bin:$PATH"; fi
