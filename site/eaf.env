# Site preset for a Fermilab EAF server (JupyterHub), sourced in a terminal. In a notebook, sourcing it in a %%bash
# cell does not reach the Python kernel or later cells: notebooks/quickstart_eaf.ipynb loads it into os.environ instead.
# EAF mounts the same Fermilab storage as the GPVMs, so the release and your data area have the same paths as there:
#   export M2FS_INPUTS=<release root> MANIFEST=<manifest>      # from your access request (setup/README.md)
#   export M2FS_DATA=<your Mu2e data area>/fastsim             # writable, with quota; not $HOME
#   source site/eaf.env && python3 site/check.py eaf
# The Python environment is a venv at $M2FS_VENV on that storage, so it outlives the server (QUICKSTART.md).

. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/common.sh" || return 1 2>/dev/null || exit 1

if [ -x "$M2FS_VENV/bin/python3" ]; then export PATH="$M2FS_VENV/bin:$PATH"; fi
# a GPU slice server runs JAX on the GPU; a CPU server falls back to the CPU
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-false}"
