Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-rockylinux9

%labels
    org.opencontainers.image.title mu2e-celeritas
    org.opencontainers.image.source https://github.com/RobMina/mu2e-fastsim
    org.opencontainers.image.description Celeritas (GPU EM transport) + Geant4 11.3 + VecGeom for the Mu2e elebeam_flash feasibility study

%help
    Celeritas @CELERITAS@ with CUDA (sm_80, A100), VecGeom 1.2.11 (+gdml, CUDA), Geant4 11.3.2 (Mu2e's version, with its data sets), G4VG, covfie,
    built with spack 1.2 following Celeritas' own rocky-cuda12 recipe (scripts/docker/dev/rocky-cuda12.yaml). The spack
    builtin repo has Celeritas up to 0.6.3, which needs VecGeom 1.2.x (0.7.0 and VecGeom 2.2 are not packaged there yet).
    Purpose: run Celeritas' standalone Geant4 app celer-g4 on the Mu2e GDML export with the DS field map, as the first
    step of route A of the electron-beam flash GPU study. No Mu2e-internal data inside.
      apptainer exec --nv mu2e-celeritas.sif celer-g4 --help
      apptainer exec --nv mu2e-celeritas.sif geant4-config --datasets

%environment
    . /opt/view-env.sh
    export G4FORCENUMBEROFTHREADS=1

%post
    set -e
    dnf install -y -q epel-release
    dnf --enablerepo epel install -y -q bzip2 curl-minimal file findutils gcc-c++ gcc gcc-gfortran git gnupg2 \
        hostname iproute make patch python3 python3-pip python3-setuptools unzip xz zstd which
    dnf clean all
    export SPACK_ROOT=/opt/spack
    mkdir -p $SPACK_ROOT
    curl -sL https://api.github.com/repos/spack/spack/tarball/@SPACK_VERSION@ | tar xzC $SPACK_ROOT --strip 1
    . $SPACK_ROOT/share/spack/setup-env.sh
    spack bootstrap now >/dev/null
    spack compiler find >/dev/null
    mkdir -p /opt/spack-environment
    cat > /opt/spack-environment/spack.yaml <<'EOF'
spack:
  specs:
    - "celeritas@@CELERITAS@ +cuda +geant4 +vecgeom +covfie cuda_arch=80 cxxstd=20"
    - "geant4@11.3.2 cxxstd=20 ~opengl ~qt ~motif ~x11 +threads"
    - "vecgeom@1.2.11 +gdml +cuda cuda_arch=80 cxxstd=20"
    - "g4vg"
    - "covfie +cuda cuda_arch=80"
    - cmake
    - ninja
    - nlohmann-json
    - cli11
    - hepmc3
  concretizer:
    unify: true
  packages:
    cuda:
      buildable: false
      externals:
        - spec: cuda@12.6.3
          prefix: /usr/local/cuda
    all:
      target: [x86_64_v3]
      variants: +cuda cuda_arch=80
  config:
    install_tree:
      root: /opt/software
    build_jobs: @JOBS@
    build_stage:
      - /opt/spack-stage
  view: /opt/view
EOF
    cd /opt/spack-environment
    spack env activate -d .
    spack concretize -f
    spack install --fail-fast
    # runtime environment as plain exports (no spack shell function needed when the image runs)
    spack env activate --sh -d . | grep -E '^export (PATH|LD_LIBRARY_PATH|CMAKE_PREFIX_PATH|MANPATH|PKG_CONFIG_PATH|G4[A-Z0-9_]*DATA|G4[A-Z_]*)=' > /opt/view-env.sh
    grep -q '^export PATH=' /opt/view-env.sh || echo 'export PATH=/opt/view/bin:$PATH' >> /opt/view-env.sh
    grep -q '^export LD_LIBRARY_PATH=' /opt/view-env.sh || echo 'export LD_LIBRARY_PATH=/opt/view/lib:/opt/view/lib64:${LD_LIBRARY_PATH:-}' >> /opt/view-env.sh
    # Geant4 data-set variables (geant4 +data installs them; geant4.sh sets G4*DATA)
    G4SH=$(ls /opt/view/bin/geant4.sh 2>/dev/null || true)
    [ -n "$G4SH" ] && echo ". $G4SH >/dev/null 2>&1" >> /opt/view-env.sh
    rm -rf /root/.spack/cache $SPACK_ROOT/var/spack/cache /opt/spack-stage   # never /tmp: apptainer binds the host's /tmp during %post
    cat /opt/view-env.sh

%test
    . /opt/view-env.sh
    which celer-g4 celer-sim geant4-config
    geant4-config --version
    geant4-config --datasets | head -3
    nvcc --version | tail -1
