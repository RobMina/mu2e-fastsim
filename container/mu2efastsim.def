Bootstrap: docker
From: python:3.13-slim-bookworm

%labels
    org.opencontainers.image.title mu2e-fastsim
    org.opencontainers.image.source https://github.com/RobMina/mu2e-fastsim
    org.opencontainers.image.licenses Apache-2.0 AND BSD-3-Clause

%help
    Variant: @VARIANT@ (trimmed CUDA wheels: @TRIM@).
    Built from git-tracked files only (see /opt/mu2e-fastsim/VERSION for the commit).
    Mu2e Geant4-free fast simulation and CRV fast reconstruction (mu2efastsim, crvfastsim, trkfastsim) with JAX.
    One image for CPU and NVIDIA GPU (JAX's pip CUDA 12 wheels; on a GPU node run with --nv).
    No CVMFS: the public Offline files the code reads are under /opt/offline_data (MU2E_SEARCH_PATH); the public CRY 1.7
    sea-level table of the device CRY source is /opt/cry/data/cosmics_0.data (notices under /opt/cry/share/licenses).
    No Mu2e-internal data inside; mount inputs and outputs at run time.
      apptainer run --nv mu2efastsim.sif crvfastsim reco-bench synthetic --stage chain --max-events 20000
      apptainer exec mu2efastsim.sif python -m pytest -q /opt/mu2e-fastsim/crv/tests

%files
    . /opt/mu2e-fastsim

%environment
    export MU2E_SEARCH_PATH=/opt/offline_data
    export XLA_PYTHON_CLIENT_PREALLOCATE=false
    export JAX_ENABLE_X64=1
    export MPLBACKEND=Agg
    export PYTHONDONTWRITEBYTECODE=1

%post
    set -e
    export PIP_NO_CACHE_DIR=1
    # git: the test suites run in this image, and the snapshot and test-selection tests build git fixtures
    apt-get update -qq && apt-get install -y -qq --no-install-recommends curl ca-certificates git \
        && rm -rf /var/lib/apt/lists/*
    python -m pip install -q --upgrade pip
    # The CI test environment, pinned (core/ci/requirements.txt: numpy, scipy, pandas, awkward, uproot, matplotlib,
    # pyarrow, PyYAML, pytest, hep-endpoints). VARIANT gpu: JAX with the pip CUDA 12 wheels, minus the ones the kernels
    # never load (TRIM, below); cpu: the CPU JAX of the file.
    REQ=/opt/mu2e-fastsim/core/ci/requirements.txt
    if [ "@VARIANT@" = cpu ]; then
        python -m pip install -q -r $REQ
    else
        sed 's/^jax==/jax[cuda12]==/' $REQ > /tmp/requirements-gpu.txt
        python -m pip install -q -r /tmp/requirements-gpu.txt && rm /tmp/requirements-gpu.txt
        for w in @TRIM@; do python -m pip uninstall -q -y "$w" || true; done
    fi
    for p in core crv tracker; do python -m pip install -q --no-deps /opt/mu2e-fastsim/$p; done
    sh /opt/mu2e-fastsim/container/fetch_offline_data.sh /opt/offline_data
    sh /opt/mu2e-fastsim/container/fetch_cry_data.sh /opt/cry
    find / -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
    printf '#!/bin/sh\nexec python -m crvfastsim "$@"\n' > /usr/local/bin/crvfastsim && chmod +x /usr/local/bin/crvfastsim

%runscript
    exec "$@"

%test
    python -c "import mu2efastsim, crvfastsim, crvfastsim.cli, crvfastsim.reco.chain_jax, jax; print('jax', jax.__version__)"
    python -c "import pyarrow, scipy, yaml, hependpoints; print('pyarrow', pyarrow.__version__)"
    git --version
    cd /opt/cry/data && sha256sum -c /opt/cry/DATA.sha256
    python -c "from mu2efastsim import cry_tables; cry_tables.load(); print('device CRY table verified')"
