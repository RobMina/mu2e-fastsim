# Site settings for the job scripts of every submodule. Copy to site.env (git-ignored), fill in the first block, and
# `source site.env` before running anything (it also puts core/crv/tracker on PYTHONPATH).
export M2FS_CODE=/path/to/mu2e-fastsim                  # this repository (with submodules) on the Mu2e machines
export M2FS_DATA=/path/to/data/area                      # outputs; each stage writes under its own subdirectory
export M2FS_PNFS=/pnfs/mu2e/scratch/users/$USER          # grid outputs (dCache scratch)
export M2FS_OWNER=$USER                                  # owner field of Mu2e file names
export M2FS_EAGLE="/eagle/ALCF_PROJECT/$USER/mu2efastsim"     # ALCF work area (literal path: IRI does not expand variables)
export ALCF_PROJECT="ALCF_PROJECT"                       # ALCF allocation (job "account")
export IRI=/path/to/genesis-skills/skills/amsc-skills/iri-api  # AI-ModCon/genesis-skills iri-api skill (laptop)
export IRI_PY=python3                                    # a python with globus-sdk (the iri-api skill's requirements)

export PYTHONPATH=$M2FS_CODE/core:$M2FS_CODE/crv:$M2FS_CODE/tracker${PYTHONPATH:+:$PYTHONPATH}

# CRV stage (crv/): job scripts read CRVFS_*
export CRVFS_CODE=$M2FS_CODE/crv
export CRVFS_DATA=$M2FS_DATA/crv_fastsim
export CRVFS_PNFS=$M2FS_PNFS/crv_fastsim
export CRVFS_OWNER=$M2FS_OWNER
export CRVFS_EAGLE=$M2FS_EAGLE
export CRVFS_FCL_PATH=/path/to/fcl/dirs                  # extra FHICL_FILE_PATH for crv/art/dump_crvreco_ref.sh (data unpack fcl)
export CRVFS_SEARCH_PATH=/path/to/payload/root           # extra MU2E_SEARCH_PATH for the payloads that unpack fcl names
export CRVFS_STOCK_AREA=/path/to/built/muse/area         # Offline build with libmu2e_CRVReco.so, for crvfastsim reco-vr2stock

# Tracker stage (tracker/)
export TRKFS_CODE=$M2FS_CODE/tracker
