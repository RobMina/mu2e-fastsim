# Site settings for the job scripts. Copy to site.env (git-ignored), fill in, and `source site.env` before running.
export M2FS_CODE=/path/to/mu2e-fastsim                  # this repository (with submodules) on the Mu2e machines
export M2FS_DATA=/path/to/data/area/mu2e_fastsim         # outputs: tables, profiles, plots
export M2FS_PNFS=/pnfs/mu2e/scratch/users/$USER/mu2e_fastsim   # grid outputs (dCache scratch)
export M2FS_EAGLE=/eagle/<alcf-project>/$USER/mu2efastsim      # ALCF work area (literal path: IRI does not expand variables)
export ALCF_PROJECT=<alcf-project>                     # ALCF allocation (job "account")
export IRI=/path/to/genesis-skills/skills/amsc-skills/iri-api  # AI-ModCon/genesis-skills iri-api skill
export IRI_PY=python3                                  # a python with globus-sdk (the iri-api skill's requirements)
