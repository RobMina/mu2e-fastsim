# Site configuration of mu2e-fastsim, the one site template of all four repositories (umbrella, core, crv, tracker).
# Copy to site.env (git-ignored) or keep it outside the clone, replace every placeholder, and source it from the
# umbrella checkout. Nothing in the code falls back to a user name or a built-in site path: a command that needs a
# variable you have not set stops with a message naming it. Blocks you do not use (an endpoint, the grid, ALCF, the
# Offline runner) can stay commented out. docs/running.md explains each block.

# --- code and data (all Python validation needs only this block) ------------------------------------------------
export M2FS_CODE="$PWD"                                    # this umbrella checkout
export M2FS_INPUTS=/path/to/approved/read-only/input-release
export M2FS_DATA=/path/to/your/writable/outputs           # on a Mu2e GPVM: your Mu2e data area
export PYTHONPATH="$M2FS_CODE/core:$M2FS_CODE/crv:$M2FS_CODE/tracker:$M2FS_CODE/beam${PYTHONPATH:+:$PYTHONPATH}"
# export M2FS_CORE="$M2FS_CODE/core"                       # core checkout for crv/tracker art helper scripts
# export M2FS_VENV=/path/to/python-jax/venv                # venv used by FNAL-side job bodies (EAF, GPVM)

# --- hosts and accounts -------------------------------------------------------------------------------------------
export FASTSIMKIT_FNAL_HOST=your-fnal-interactive-host     # ssh name of the FNAL host that serves Mu2e inputs
export FASTSIMKIT_SLURM_HOST=your-slurm-login-host         # ssh name of the Slurm cluster's login host
export FASTSIMKIT_SLURM_ACCOUNT=your-slurm-account         # Slurm account the kit charges
export SBATCH_ACCOUNT="$FASTSIMKIT_SLURM_ACCOUNT"          # read by sbatch itself for the repository's .sbatch files
# export SBATCH_PARTITION=standard                         # optional; the scripts name their partition

# --- Slurm endpoint (kit over ssh, Apptainer image) ---------------------------------------------------------------
export FASTSIMKIT_SCRATCH=/path/to/your/slurm/work-area   # working area on the Slurm cluster
export FASTSIMKIT_SIF="$FASTSIMKIT_SCRATCH/mu2efastsim.sif"
export FASTSIMKIT_WORKDIR="$FASTSIMKIT_SCRATCH/kit"
export M2FS_UVA="$FASTSIMKIT_SCRATCH"                     # area used by the core uva/ job scripts
# export FASTSIMKIT_STATE_DIR=~/.mu2efastsim/kit           # kit state on the kit host (this is the default)
# export FASTSIMKIT_CHANNEL_DIR=~/.mu2efastsim/ssh_slots   # ssh multiplexing slots (this is the default)
# Retained code snapshots on the endpoint, one per task family (they may be checked out at different refs, so do not
# point two of them at one directory). The values shown are the defaults:
# export FASTSIMKIT_CODE="$FASTSIMKIT_SCRATCH/chain_code_kit"                # chain_point
# export FASTSIMKIT_CRV_CODE="$FASTSIMKIT_SCRATCH/crv_response_code_kit"     # crv_response
# export FASTSIMKIT_TRACKER_CODE="$FASTSIMKIT_SCRATCH/tracker_code_kit"      # tracker_point
# export FASTSIMKIT_BEAM_CODE="$FASTSIMKIT_SCRATCH/beam_code_kit"            # beam_point
# export FASTSIMKIT_CODE_REF=main                          # branch or commit snapshotted (default main)
# export FASTSIMKIT_DEVICE_FLOAT=float32                    # device float of kit CRV jobs: float32 (default) or float64
# export FASTSIMKIT_JAX_CACHE="$FASTSIMKIT_SCRATCH/jaxcache" # shared JAX compilation cache of jobs (this is the default; "" = off)
# export FASTSIMKIT_CRV_CODE_REF=main                      # umbrella ref of the crv_response snapshot (default main)
# Inputs the kit streams from FASTSIMKIT_FNAL_HOST (paths on that host):
export FASTSIMKIT_FNAL_DATA="$M2FS_INPUTS/crv_fastsim"
export FASTSIMKIT_CRV_DATA="$FASTSIMKIT_FNAL_DATA"
export FASTSIMKIT_BEAM_DATA="$M2FS_INPUTS/beam_fastsim"     # holds g4ref_full/g4ref.npz
export FASTSIMKIT_TRACKER_DATA="$M2FS_INPUTS"               # release root, not its crv_fastsim child
export FASTSIMKIT_GEOMETRY_PREFIX="$M2FS_INPUTS/"           # absolute beam_point geometry paths must lie below it

# --- Fermilab EAF -------------------------------------------------------------------------------------------------
# export FASTSIMKIT_EAF_SHARED_PREFIX=/path/mounted/by/eaf/and/the/fnal/host
# export FASTSIMKIT_EAF_CODE="$M2FS_CODE"                   # the default
# export FASTSIMKIT_EAF_WORKDIR="$M2FS_DATA/crv_fastsim/eafkit"   # the default
# export FASTSIMKIT_EAF_VENV="$M2FS_DATA/crv_fastsim/venv_eaf"    # the default; also the default VENV of beam/art/*.sh
# export EAF_TOKEN_FILE=/path/to/your/mode-600/token       # your own token; never put the token itself here

# --- FNAL grid (pnfs) ---------------------------------------------------------------------------------------------
# export M2FS_PNFS=/path/to/your/pnfs/scratch/area         # your dCache scratch area (outputs, code tarballs)
# export CRVFS_PNFS="$M2FS_PNFS/crv_fastsim"
# export TRKFS_PNFS="$M2FS_PNFS/trk_fastsim"
# export PNFS_OUT="$M2FS_PNFS/beam_closure_NEW_TAG"        # beam/art/submit_beam_closure.sh, a new directory per run
# export CRVFS_OWNER=your-grid-user-name                   # OWNER recorded in grid jobs
# export CRVFS_DCACHE=/path/to/dcache/mount                 # dCache mount point (grid inputs/outputs live below it)
# export CRVFS_XROOTD=root://dcache.door.example//path/to/dcache/mount   # xrootd prefix for that mount
# export TRKFS_OWNER="$CRVFS_OWNER"

# --- ALCF (Polaris via IRI, Aurora) -------------------------------------------------------------------------------
# export ALCF_PROJECT=YOUR_ALCF_PROJECT
# export AURORA_HOST=aurora                       # ssh host (alias) of Aurora, for core aurora/kpp_stream.sh
# export AURORA_SUBMIT_DIR=/path/on/aurora/submit/dir   # qsub working directory for core aurora/kpp_stream.sh
# export M2FS_EAGLE=/path/to/your/eagle/project/area
# export M2FS_FLARE=/path/to/your/flare/project/area
# export CRVFS_EAGLE="$M2FS_EAGLE"
# export IRI=/path/to/your/iri-api/client
# export IRI_PY=python3
# export IRI_FACILITY=alcf

# --- CRV (crv/) ---------------------------------------------------------------------------------------------------
export CRVFS_CODE="$M2FS_CODE/crv"
export CRVFS_DATA="$M2FS_INPUTS/crv_fastsim"
export CRVFS_LOOKUP_DIR="$CRVFS_DATA/lookup_v6_0"
# export MU2EFS_DEVICE_FLOAT=float32                       # CRV device (JAX) kernels: float32 (default) or float64 (bit-identical across GPU models)
# export CRVFS_OFFLINE_ROOT=/path/to/Offline/tree      # optional local Offline checkout searched before the CVMFS release
export MU2E_SEARCH_PATH="$M2FS_INPUTS/offline"
export CRVFS_OFFLINE_CACHE="$M2FS_DATA/cache/offline"
# export CRVFS_NO_FETCH=1                                  # refuse hidden fetching with a verified local Offline tree
# export CRVFS_FCL_PATH=/path/to/fcl/dirs
# export CRVFS_SEARCH_PATH=/path/to/payload/root
# export CRVFS_STOCK_AREA=/path/to/built/muse/area
# export CRVFS_VALIDATION_OFFLINE=/path/to/offline/source/and/waveform/root
# export CRVFS_OFFLINE_RELEASE=/path/to/offline/release
# export CRVFS_PREPARED_LIBRARY_CACHE="$M2FS_DATA/cache/tier1b"
# export CRVFS_HOST_LOCKS=/path/to/host/locks              # one-job-per-host lock directory (generator-bank campaign)
# export STEP_LAYERS_OUT=/path/to/step/layers/output
# export VR4_BASE=/path/to/vr4/area                        # VR4/VR5 grid validation drivers
# export VR5_BASE=/path/to/vr5/area
# export CRVFS_OUT=/path/to/your/writable/crv-output        # some CRV drivers; pass it as --outdir
# export CRVVAL_AREA=/path/to/built/validation/muse/area   # stock-validation area (crv/valhist/setup_crvval_area.sh)
# export CRVFS_RECORDED_DATA=/path/recorded/in/manifests    # data root recorded in old manifests (default CRVFS_DATA)
# export CRVONLY_V05_NTS=/path/to/crvonly_v05/nts           # crv/grid/vr5_collect.sh
# export FILELIST=/path/to/dts_filelist.txt MCR=/path/to/mu2e_track_crv_mcresponse   # crv/grid/submit_vr5_stock.sh
# export FASTSIM_CPU_SIF=/path/to/mu2efastsim_cpu.sif       # crv/grid/submit_vr4*.sh

# --- tracker (tracker/) -------------------------------------------------------------------------------------------
export TRKFS_CODE="$M2FS_CODE/tracker"
# export TRK_FASTRECO_DATA="$M2FS_DATA/trk_fastreco"        # F1 inputs (the default)
# export UVA_HOST=your-slurm-login-host                     # override of FASTSIMKIT_SLURM_HOST in tracker/scripts/uva_steps_stream.sh
# export TRKFS_ART="$TRKFS_CODE/art"                       # muse area with the tracker art modules built
# export PY_JAX=/path/to/python-with-jax                  # interpreter for tracker JAX drivers (also PY / VENV)
# export CRVEXTRAP=/path/to/crvextrap/checkout             # ntuple, straw-occupancy and secondary analysis scripts
# export TRKFS_MUSE_AREAS=/path/to/muse/areas              # saved F1 capture muse areas
# export F1_PUBLISHER_ART=/path/to/publisher/art/file      # F1 pair drivers
# export CVMFSEXEC_DIST=/path/to/cvmfsexec/el8/client      # saved CVMFS client for the container Offline runner

# --- beam (beam/) -------------------------------------------------------------------------------------------------
export BEAMFS_DATA_ROOT="$M2FS_DATA/beam_fastsim"         # foil-closure and physics-table outputs must be inside it
# export BEAMFS_CORE="$M2FS_CODE/core"                     # core checkout shipped with grid jobs (default: core/)
# export VENV=/path/to/python-jax/venv                     # beam/art/run_fast_cpu.sh, eaf_beam.sh

# --- Offline (art) runner without host CVMFS (container/offline/, tracker digi runtime) --------------------------
# export CVMFSEXEC_DIST=/path/to/prepared/cvmfsexec
# export OFFLINE_IMAGE=/cvmfs/singularity.opensciencegrid.org/fermilab/fnal-wn-el9:latest   # the default
# export OFFLINE_ROOT=/path/to/offline/runner/outputs     # holds code/ (this checkout) for the .sbatch fixtures
# export OFFLINE_AREA=/path/to/built/muse/area/or/trusted/Code.tar.bz2
# export OFFLINE_INPUT=/path/to/staged/reference/inputs
# export OFFLINE_G4_TABLE=/path/to/staged/g4/steps/table
# export OFFLINE_REFERENCE=/path/to/reference/dqm/directory
# export OFFLINE_BRIDGE=/path/to/completed/bridge/directory
# export FASTSIM_IMAGE="$FASTSIMKIT_SIF"                   # Python image for compare_reference.sbatch
# export OFFLINE_BINDS=/path/to/tables                     # extra same-path binds, comma-separated
# export OFFLINE_FCL_PATH=/path/to/fcl/include/dirs
# export OFFLINE_SEARCH_PATH=/path/to/private/geometry/or/conditions
# export OFFLINE_NODE_TMP=/tmp                             # node-local cache root (/tmp, /local or /localscratch)
# export OFFLINE_CVMFS_PROXY=DIRECT

# export APPTAINER_TMPDIR=/path/to/local/build/tmp         # container/build.sh (default: a fresh dir under TMPDIR)
# export APPTAINER_CACHEDIR=/path/to/local/build/cache
