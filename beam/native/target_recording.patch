+      if (targetRecording_) targetRecording_->stacking(*trk, static_cast<int>(fKill), true, false);
       return fKill;
     }
     if(commonCuts_->stackingActionCut(trk)) {
+      if (targetRecording_) targetRecording_->stacking(*trk, static_cast<int>(fKill), false, true);
       return fKill;
     }
+    if (targetRecording_) targetRecording_->stacking(*trk, static_cast<int>(fUrgent), false, false);
     return fUrgent;
   }
 
