# Independent saved-output event/status audit for a newly generated library stage.
#include "Offline/fcl/minimalMessageService.fcl"
#include "Offline/fcl/standardServices.fcl"
process_name : R1LibraryRead
source : { module_type : RootInput }
services : @local::Services.Core
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_run1_a.txt"
services.GeometryService.bFieldFile : "Offline/Mu2eG4/geom/bfgeom_no_tsu_ps_v01.txt"
physics : {
  analyzers : {
    count : { module_type : RunSubrunEvent printSam : true printEvent : true }
    audit : {
      module_type : PrintModule
      PrintSubRun : false
      statusG4Printer : { verbose : 1 inputTags : [ "g4run::R1LibraryStops" ] }
      triggerResultsPrinter : { verbose : 1 inputTags : [ "TriggerResults::R1LibraryStops" ] }
    }
    cetree : {
      module_type : ReadVirtualDetector
      vdStepPoints : "g4run:virtualdetector:R1LibraryStops"
      tvdStepPoints : "g4run:timeVD:R1LibraryStops"
      simParticleColl : "g4run::R1LibraryStops"
      physicsVolumeColl : "g4run::R1LibraryStops"
      savePDG : [ "mu_minus", "mu_plus" ]
      navigateToParent : false
      writeNTVD : false
      writeNTTVD : false
      writeNTPART1 : false
    }
  }
  read : [ count, audit, cetree ]
  end_paths : [ read ]
}
services.TFileService.fileName : "library_read.root"
